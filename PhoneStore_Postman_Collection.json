              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Gửi request đăng ký tài khoản user1. Dùng chụp ảnh cho mục 1.b: ![Anh_DangKy_Postman]()"
